GEMINI_API_KEY=
# Fallback key, used automatically when the first is rate-limited or rejected
GEMINI_API_KEY_2=
# Optional: more fallback keys, comma-separated
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
# Cheaper/faster alternative: gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_TIMEOUT_S=60
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173
MAX_INPUT_CHARS=5000
TM_MATCH_COUNT=5
TM_MIN_SIMILARITY=0.6
RATE_LIMIT_PER_MIN=20
TRANSLATE_CONCURRENCY=4

# Developer API billing: clients pay Gemini cost x API_MARKUP
API_MARKUP=1.25
API_RATE_LIMIT_PER_MIN=60
# Optional price overrides (USD per 1M tokens); defaults come from app/services/pricing.py
# PRICE_INPUT_PER_M=0.75
# PRICE_OUTPUT_PER_M=3.75
# PRICE_EMBED_PER_M=0.20
